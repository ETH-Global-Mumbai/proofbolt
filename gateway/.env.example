# Set DEV_MOCKS=1 to run with a fake AI and without Arkiv or 0G, then remove it for anything real.
DEV_MOCKS=1
# With DEV_MOCKS=1: the fake AI's answer (OPEN, HOLD, ALERT or DOWN), or LIVE to use the real 0G AI.
DEV_AI=OPEN

PORT=8080

# Lock. Must match firmware/include/secrets.h. Generate the key with: openssl rand -hex 32
LOCK_URL=http://127.0.0.1:8081
LOCK_ID=locker-1
LOCK_KEY_HEX=

# Arkiv. Create a wallet with: pnpm arkiv wallet. Access key: https://hub.arkiv.network/access-keys
# With DEV_MOCKS=1, leave ARKIV_PRIVATE_KEY empty to keep grants in a local file instead.
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=
# Status page: the gateway wallet's address, and nothing that can sign.
ARKIV_GATEWAY_ADDRESS=
STATUS_PORT=8090

# 0G Router. Get a key at https://pc.0g.ai
OG_API_KEY=
OG_MODEL=qwen3.8-flash
OG_VERIFY_TEE=0
# 0G Storage and Chain (Galileo testnet). Create a wallet with: pnpm zerog wallet. Faucet: https://faucet.0g.ai
# With DEV_MOCKS=1, leave OG_PRIVATE_KEY empty to skip publishing decisions.
OG_PRIVATE_KEY=
# From: pnpm zerog deploy
OG_ANCHOR_ADDRESS=

# The address in access links. Set it to your tunnel to open them on a phone, which needs HTTPS for the camera.
KIOSK_URL=
