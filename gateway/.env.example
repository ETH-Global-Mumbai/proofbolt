# Set DEV_MOCKS=1 to run with a fake World ID and a fake AI, then remove it for anything real.
DEV_MOCKS=1
# With DEV_MOCKS=1: the fake AI's answer (OPEN, HOLD, ALERT or DOWN) and the fake person's World ID.
DEV_AI=OPEN
DEV_WORLD_SUB=dev-user

PORT=8080

# Lock. Must match firmware/include/secrets.h. Generate the key with: openssl rand -hex 32
LOCK_URL=http://127.0.0.1:8081
LOCK_ID=locker-1
LOCK_KEY_HEX=

# 0G Router. Get a key at https://pc.0g.ai
OG_API_KEY=
OG_MODEL=qwen3.8-flash
OG_VERIFY_TEE=0
OG_PRIVATE_KEY=
OG_ADDRESS=
OG_ANCHOR_ADDRESS=

# World ID. Register at the sandbox portal. Callbacks must be HTTPS, so use a tunnel.
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=

# Arkiv info
ARKIV_PRIVATE_KEY=
ARKIV_GATEWAY_ADDRESS=
ARKIV_ACCESS_KEY=
STATUS_PORT=8090
# The owner's page. Never put this port on a tunnel: it has no login and uses the wallet above.
OWNER_PORT=8070
KIOSK_URL=
